# SnapSTL settings for THIS computer. Copy this file to ".env" in the same folder and fill it in.
# .env is never put in git (see .gitignore) — it holds the database password.

# Shared order records (Supabase, Postgres). Every SnapSTL computer with the same value shares the
# records of batched, bundled and printed orders (so no order is made twice). Each computer still
# keeps its own local database. Leave empty for a single computer.
# Supabase → your project → Connect → "Session pooler" → URI; put your database password in it.
SNAPSTL_DATABASE_URL=

# How this computer is named on its batches (default: the computer's own name).
SNAPSTL_COMPUTER_NAME=

# Port of SnapSTL's local web page (default 8317). Only change if another program uses 8317.
# SNAPSTL_PORT=8317
