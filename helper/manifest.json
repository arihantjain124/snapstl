{
  "manifest_version": 3,
  "name": "SnapSTL Helper",
  "version": "2.7.2",
  "description": "Generates SnapSTL models on the MakerWorld model maker and makes shipping labels on ShopDeck in your own Chrome, for the SnapSTL app on this computer.",
  "permissions": [
    "storage",
    "contentSettings"
  ],
  "host_permissions": [
    "https://makerworld.com/*",
    "https://pro.shopdeck.com/*",
    "http://127.0.0.1:8317/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SnapSTL Helper"
  },
  "content_scripts": [
    {
      "matches": [
        "https://makerworld.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://makerworld.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1:8317/*",
        "http://localhost:8317/*"
      ],
      "js": [
        "snapstl_page.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://pro.shopdeck.com/*"
      ],
      "js": [
        "shopdeck.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
