  "id": "picture-frame",
  "title": "Picture Frame",
  "designs": [
    {
      "id": "folding-easel",
      "label": "Folding Easel",
      "description": "A portrait 4 × 6 in frame with a folding rear stand and optional raised lettering on either border.",
      "source": "folding-easel.scad",
      "assets": [
        "fonts/AkayaKanadaka-OFL.txt",
        "fonts/AkayaKanadaka-Regular.ttf",
        "fonts/CherryBombOne-OFL.txt",
