            "Bottom",
            "Top"
          ]
        },
        {
          "id": "max_letter_height",
          "label": "Maximum letter height",
          "type": "number",
          "minimum": 5,
          "maximum": 11,
          "default": 9,
          "step": 0.5,
          "unit": "mm"
        },
        {
          "id": "photo_clearance",
