        "fonts/LuckiestGuy-LICENSE.txt",
        "fonts/LuckiestGuy-Regular.ttf",
        "fonts/TitanOne-OFL.txt",
        "fonts/TitanOne-Regular.ttf"
      ],
      "parameters": [
        {
          "id": "personalize",
          "label": "Add raised text",
          "type": "checkbox",
          "default": true
        },
        {
          "id": "text",
          "label": "Text",
          "type": "text",
          "default": "Good Times",
          "max_length": 24
        },
        {
          "id": "font",
          "label": "Font",
          "type": "choice",
          "default": "Chewy",
          "choices": [
            "Chewy",
            "Luckiest Guy",
            "Titan One",
            "DynaPuff",
            "Cherry Bomb One",
            "Akaya Kanadaka"
          ]
